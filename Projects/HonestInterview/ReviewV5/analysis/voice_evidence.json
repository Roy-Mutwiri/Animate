[
 {
  "speaker": "NOCAP",
  "text": "Okay,",
  "start": 0.25,
  "end": 0.47,
  "yin_n": 1,
  "yin_med": 231.72869885327032,
  "pyin_n": 0,
  "pyin_med": null,
  "pyin_p10": null,
  "pyin_p90": null,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -1.22,
  "kmeans": 0
 },
 {
  "speaker": "NOCAP",
  "text": "for ten billion dollars, would you\u2014",
  "start": 0.7,
  "end": 2.45,
  "yin_n": 91,
  "yin_med": 142.77580939229554,
  "pyin_n": 128,
  "pyin_med": 143.82863912505343,
  "pyin_p10": 93.9691371741665,
  "pyin_p90": 196.24873410809192,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -1.6,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Yes.",
  "start": 2.56,
  "end": 2.87,
  "yin_n": 0,
  "yin_med": null,
  "pyin_n": 0,
  "pyin_med": null,
  "pyin_p10": null,
  "pyin_p90": null,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.14,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "Um, no, I didn't finish the question, I\u2014",
  "start": 4.84,
  "end": 7.06,
  "yin_n": 63,
  "yin_med": 109.28943575988441,
  "pyin_n": 134,
  "pyin_med": 110.58673092361124,
  "pyin_p10": 92.4563911828233,
  "pyin_p90": 118.52392351256819,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -0.78,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Listen here.",
  "start": 7.2,
  "end": 7.47,
  "yin_n": 4,
  "yin_med": 135.52285725535808,
  "pyin_n": 25,
  "pyin_med": 131.51052723924994,
  "pyin_p10": 107.43854136004751,
  "pyin_p90": 136.14823596668148,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.43,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "There is nothing,",
  "start": 8.86,
  "end": 9.41,
  "yin_n": 13,
  "yin_med": 91.58570014028031,
  "pyin_n": 48,
  "pyin_med": 95.16715783063816,
  "pyin_p10": 88.63919433695776,
  "pyin_p90": 114.02498770818535,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.53,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "and I mean nothing,",
  "start": 10.17,
  "end": 11.9,
  "yin_n": 73,
  "yin_med": 117.4488911821051,
  "pyin_n": 149,
  "pyin_med": 117.84127594565435,
  "pyin_p10": 97.95413429584742,
  "pyin_p90": 142.9359193530297,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.05,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "that could come out of that little pie hole of yours",
  "start": 12.54,
  "end": 14.42,
  "yin_n": 18,
  "yin_med": 86.30909065613739,
  "pyin_n": 86,
  "pyin_med": 87.26721268071712,
  "pyin_p10": 82.36928038865905,
  "pyin_p90": 101.99593272657759,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -0.21,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "to make me turn down ten billion dollars.",
  "start": 15.05,
  "end": 18.48,
  "yin_n": 67,
  "yin_med": 84.9471383848618,
  "pyin_n": 182,
  "pyin_med": 89.3069870847758,
  "pyin_p10": 79.10522838858842,
  "pyin_p90": 117.16256013940793,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.7,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "Even if one random person had to die?",
  "start": 20.62,
  "end": 23.35,
  "yin_n": 98,
  "yin_med": 106.2769142329831,
  "pyin_n": 210,
  "pyin_med": 106.81974089615274,
  "pyin_p10": 95.11075890129331,
  "pyin_p90": 123.4144757235675,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -1.28,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Yes.",
  "start": 23.44,
  "end": 23.84,
  "yin_n": 12,
  "yin_med": 119.40593880514584,
  "pyin_n": 15,
  "pyin_med": 119.9011051661721,
  "pyin_p10": 119.21052561660726,
  "pyin_p90": 119.9011051661721,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.43,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "The answer is yes.",
  "start": 24.04,
  "end": 25.66,
  "yin_n": 13,
  "yin_med": 116.91108722153743,
  "pyin_n": 76,
  "pyin_med": 116.48775344855382,
  "pyin_p10": 112.51975293079859,
  "pyin_p90": 124.12940850835416,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.23,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "Okay, what if it was someone you knew?",
  "start": 25.94,
  "end": 27.56,
  "yin_n": 46,
  "yin_med": 87.9041181036659,
  "pyin_n": 69,
  "pyin_med": 95.16557023646565,
  "pyin_p10": 84.19747085156703,
  "pyin_p90": 110.71485540663666,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -0.51,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Yes. Take my aunt. Take my grandma.",
  "start": 27.74,
  "end": 30.38,
  "yin_n": 15,
  "yin_med": 84.66919608093863,
  "pyin_n": 176,
  "pyin_med": 89.3069870847758,
  "pyin_p10": 79.56348031480259,
  "pyin_p90": 118.52392351256819,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.56,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "Hell, you could blow the block up.",
  "start": 30.64,
  "end": 31.78,
  "yin_n": 2,
  "yin_med": 93.25695105831076,
  "pyin_n": 58,
  "pyin_med": 84.78288453476168,
  "pyin_p10": 65.0,
  "pyin_p90": 94.07250043362458,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.68,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "Can you even fathom how much money ten billion dollars is?",
  "start": 31.9,
  "end": 37.45,
  "yin_n": 58,
  "yin_med": 86.18961762761882,
  "pyin_n": 333,
  "pyin_med": 80.95422545332349,
  "pyin_p10": 65.0,
  "pyin_p90": 97.0553397528943,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.61,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "Oh, it's just a hypothetical.",
  "start": 37.92,
  "end": 39.3,
  "yin_n": 16,
  "yin_med": 123.44383688034051,
  "pyin_n": 97,
  "pyin_med": 65.0,
  "pyin_p10": 65.0,
  "pyin_p90": 125.57172276022992,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -0.4,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "And if it was a reality,",
  "start": 39.42,
  "end": 40.93,
  "yin_n": 51,
  "yin_med": 118.6762220858692,
  "pyin_n": 125,
  "pyin_med": 117.16256013940793,
  "pyin_p10": 91.07860301516284,
  "pyin_p90": 144.74538967268535,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.9,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "I'd be first in line.",
  "start": 41.32,
  "end": 43.49,
  "yin_n": 5,
  "yin_med": 81.82906513064238,
  "pyin_n": 88,
  "pyin_med": 65.0,
  "pyin_p10": 65.0,
  "pyin_p90": 83.95472034969553,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.8,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "You're talking about human lives for ten billion dollars. What would\u2014",
  "start": 43.92,
  "end": 47.42,
  "yin_n": 105,
  "yin_med": 186.4171202332753,
  "pyin_n": 174,
  "pyin_med": 183.84776310850236,
  "pyin_p10": 145.33175986341587,
  "pyin_p90": 221.17346184722248,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -1.88,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Hey, hey, hey, hey.",
  "start": 47.46,
  "end": 48.71,
  "yin_n": 41,
  "yin_med": 187.49044643611543,
  "pyin_n": 72,
  "pyin_med": 177.09154987862257,
  "pyin_p10": 140.548318552896,
  "pyin_p90": 238.14720129902392,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.48,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "Guess what?",
  "start": 49.48,
  "end": 49.82,
  "yin_n": 9,
  "yin_med": 127.48434049269959,
  "pyin_n": 1,
  "pyin_med": 67.68203991476243,
  "pyin_p10": 67.68203991476243,
  "pyin_p90": 67.68203991476243,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.17,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "I don't want to guess. Don't make me guess.",
  "start": 50.32,
  "end": 52.08,
  "yin_n": 7,
  "yin_med": 110.91277536055901,
  "pyin_n": 31,
  "pyin_med": 65.0,
  "pyin_p10": 65.0,
  "pyin_p90": 66.51930297979037,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.14,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "Oh, come on. You gotta be curious about what I'm going to tell you.",
  "start": 52.33,
  "end": 55.1,
  "yin_n": 69,
  "yin_med": 122.37951054200151,
  "pyin_n": 140,
  "pyin_med": 105.9021912900791,
  "pyin_p10": 66.51930297979037,
  "pyin_p90": 135.44249544324052,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.24,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "What?",
  "start": 56.94,
  "end": 57.12,
  "yin_n": 0,
  "yin_med": null,
  "pyin_n": 0,
  "pyin_med": null,
  "pyin_p10": null,
  "pyin_p90": null,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.47,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "I would have did it for five.",
  "start": 58.55,
  "end": 59.78,
  "yin_n": 9,
  "yin_med": 93.86593790223404,
  "pyin_n": 65,
  "pyin_med": 74.66539307480728,
  "pyin_p10": 65.0,
  "pyin_p90": 97.50409461869872,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.13,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "Five billion?",
  "start": 61.1,
  "end": 62.08,
  "yin_n": 51,
  "yin_med": 228.865145290852,
  "pyin_n": 62,
  "pyin_med": 226.34314645699226,
  "pyin_p10": 65.0,
  "pyin_p90": 385.7813206140291,
  "mfcc_loo_pred": "NOCAP",
  "mfcc_margin": -0.22,
  "kmeans": 0
 },
 {
  "speaker": "CAP",
  "text": "Thousand.",
  "start": 62.51,
  "end": 63.1,
  "yin_n": 0,
  "yin_med": null,
  "pyin_n": 4,
  "pyin_med": 92.9919856082918,
  "pyin_p10": 92.9919856082918,
  "pyin_p90": 92.9919856082918,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.07,
  "kmeans": 1
 },
 {
  "speaker": "NOCAP",
  "text": "What are you?",
  "start": 63.4,
  "end": 64.0,
  "yin_n": 10,
  "yin_med": 199.5127374049598,
  "pyin_n": 5,
  "pyin_med": 92.9919856082918,
  "pyin_p10": 92.4563911828233,
  "pyin_p90": 93.3152038637387,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 0.73,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "Oh, that's a good question.",
  "start": 64.66,
  "end": 65.55,
  "yin_n": 1,
  "yin_med": 131.17174401040668,
  "pyin_n": 41,
  "pyin_med": 65.0,
  "pyin_p10": 65.0,
  "pyin_p90": 65.0,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.52,
  "kmeans": 1
 },
 {
  "speaker": "CAP",
  "text": "I guess you can call me an entrepreneur.",
  "start": 66.68,
  "end": 70.46,
  "yin_n": 47,
  "yin_med": 86.48584262527044,
  "pyin_n": 254,
  "pyin_med": 78.64961579925402,
  "pyin_p10": 65.0,
  "pyin_p90": 94.07250043362458,
  "mfcc_loo_pred": "CAP",
  "mfcc_margin": 1.64,
  "kmeans": 1
 }
]