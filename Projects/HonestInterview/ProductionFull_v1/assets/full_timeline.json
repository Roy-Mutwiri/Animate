    {
      "start": 0.0,
      "end": 2.34,
      "speaker": "interviewer",
      "text": "Okay, for $10 billion, would you",
      "mood": "question"
    },
    {
      "start": 2.56,
      "end": 2.82,
      "speaker": "respondent",
      "text": "Yes.",
      "mood": "snap"
    },
    {
      "start": 4.44,
      "end": 7.7,
      "speaker": "interviewer",
      "text": "Um, I didn't finish the question. I'd listen here.",
      "mood": "object"
    },
    {
      "start": 8.64,
      "end": 18.72,
      "speaker": "respondent",
      "text": "There was nothing. And I mean nothing that could come out of that little pie hole of yours to make me turn down $10 billion.",
      "mood": "confident"
    },
    {
      "start": 20.48,
      "end": 23.44,
      "speaker": "interviewer",
      "text": "Even if one random person had to die?",
      "mood": "question"
    },
    {
      "start": 23.44,
      "end": 25.12,
      "speaker": "respondent",
      "text": "Yes. The answer is yes.",
      "mood": "flat_yes"
    },
    {
      "start": 25.84,
      "end": 27.6,
      "speaker": "interviewer",
      "text": "Okay, what if it was someone you knew?",
      "mood": "press"
    },
    {
      "start": 27.6,
      "end": 37.36,
      "speaker": "respondent",
      "text": "Yes, take my aunt, take my grandma, hell, you could blow the block up. Can you even fathom how much money $10 billion is?",
      "mood": "rant"
    },
    {
      "start": 38.0,
      "end": 39.44,
      "speaker": "interviewer",
      "text": "Oh, it's just a hypothetical.",
      "mood": "uneasy"
    },
    {
      "start": 39.44,
      "end": 43.76,
      "speaker": "respondent",
      "text": "And if it was a reality, I'd be first in line.",
      "mood": "smug"
    },
    {
      "start": 43.76,
      "end": 47.12,
      "speaker": "interviewer",
      "text": "You're talking about human lives for $10 billion.",
      "mood": "moral"
    },
    {
      "start": 47.12,
      "end": 49.84,
      "speaker": "respondent",
      "text": "Hey, hey, hey, hey. Guess what?",
      "mood": "tease"
    },
    {
      "start": 50.4,
      "end": 52.16,
      "speaker": "interviewer",
      "text": "I don't want to guess. Don't make me guess.",
      "mood": "annoyed"
    },
    {
      "start": 52.16,
      "end": 55.12,
      "speaker": "respondent",
      "text": "Oh, come on. You got to be curious about what I'm going to tell you.",
      "mood": "tease"
    },
    {
      "start": 55.12,
      "end": 57.12,
      "speaker": "interviewer",
      "text": "What?",
      "mood": "short"
    },
    {
      "start": 58.4,
      "end": 62.08,
      "speaker": "respondent",
      "text": "I would have did it for $5 billion?",
      "mood": "reveal"
    },
    {
      "start": 62.08,
      "end": 64.56,
      "speaker": "interviewer",
      "text": "$1,000. What are you?",
      "mood": "shocked"
    },
    {
      "start": 64.56,
      "end": 65.6,
      "speaker": "respondent",
      "text": "Oh, that's a good question.",
      "mood": "consider"
    },
    {
      "start": 66.56,
      "end": 70.32,
      "speaker": "respondent",
      "text": "I guess you can call me an entrepreneur.",
      "mood": "punchline"
    }
